# Copy to .env and adjust for local development.

MCP_TRANSPORT=http
PORT=8080

# Upstream Viraly API (where Bearer tokens are validated and tools are dispatched).
VIRALY_API_ORIGIN=https://api.staging.viraly.io
VIRALY_OAUTH_ISSUER=https://api.staging.viraly.io

# Public origin of THIS server (used in OAuth Protected Resource Metadata).
MCP_PUBLIC_ORIGIN=https://localhost:8080

# Comma-separated list of CORS-permitted origins; empty disables CORS.
MCP_CORS_ORIGINS=

LOG_LEVEL=debug
MCP_RATE_LIMIT_PER_MINUTE=300

# Stdio-transport only — get a vat_* token by completing the OAuth flow at
# https://app.staging.viraly.io/oauth/authorize?...
# VIRALY_ACCESS_TOKEN=vat_replace_me
